{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=OperationsPlatformDb;Trusted_Connection=True;MultipleActiveResultSets=True;Encrypt=True;TrustServerCertificate=True;"
  },
  "Frontend": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:55397"
    ]
  },
  "CSharpWorker": {
    "RelativeDllPath": "csharp-worker/OperationsPlatform.CSharpWorker.dll",
    "ExecutionTimeoutSeconds": 8,
    "MaxSourceCodeLength": 30000
  },
  "RestApi": {
    "DefaultTimeoutSeconds": 15,
    "MaxResponseBytes": 1048576,
    "AllowPrivateNetworkTargets": true
  },
  "Execution": {
    "TimeZoneId": "Israel Standard Time",
    "MaxInputLength": 10000,
    "MaxBuilderNodes": 30
  },
  "Logging": {
    "MaxBodyChars": 12000
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
